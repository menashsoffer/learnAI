{
  "name": "learnai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Extensible RTL presentation platform — from single-deck lecture site to multi-deck platform",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:decks": "tsx scripts/validate-decks.ts",
    "run-sheet": "tsx scripts/generate-run-sheet.ts",
    "run-sheet:check": "tsx scripts/generate-run-sheet.ts --check",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run validate:decks && npm run run-sheet:check"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.1.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fast-xml-parser": "^5.11.1",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "zod": "^3.24.1"
  }
}
