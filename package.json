{
  "name": "learnai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Extensible RTL presentation platform — from single-deck lecture site to multi-deck platform",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:deck": "tsx scripts/build-decks.ts",
    "preview": "vite preview",
    "validate:decks": "tsx scripts/validate-decks.ts",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.1.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^2.1.8",
    "zod": "^3.24.1"
  }
}
